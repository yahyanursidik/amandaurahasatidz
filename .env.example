APP_ENV=development
APP_URL=http://localhost:3000

# Connection Pooled Database URL for serverless application requests
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct Unpooled Database URL for Drizzle Kit migrations
DATABASE_MIGRATION_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

AUTH_SECRET=super-secret-key-at-least-32-characters-long
SESSION_SECRET=use-a-different-random-secret-at-least-32-characters
INVITATION_ACCESS_SECRET=use-another-random-secret-at-least-32-characters
PARTICIPANT_QR_SECRET=use-a-dedicated-random-secret-or-fallback-to-session-secret
SEED_DEFAULT_PASSWORD=replace-with-a-strong-development-password
LOG_LEVEL=info

# Mailketing API v2 (server-only; never use VITE_ prefix)
EMAIL_PROVIDER=MAILKETING
MAILKETING_API_TOKEN=replace-with-token-from-mailketing-dashboard
MAILKETING_FROM_EMAIL=no-reply@yts.web.id
MAILKETING_FROM_NAME=Aman Daurah Asatidz
ENABLE_AUTOMATED_REMINDERS=false
EMAIL_WORKER_ENABLED=false

# Optional SMTP fallback only when EMAIL_PROVIDER=SMTP
EMAIL_HOST=mail.radiotarbiyahsunnah.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=no-reply@radiotarbiyahsunnah.com
EMAIL_PASS=your-email-password-here
EMAIL_FROM_NAME=Panitia Daurah YTS
